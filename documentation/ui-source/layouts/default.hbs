<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{#if page.title}}{{{page.title}}} · {{/if}}{{site.title}}</title>
  {{#if page.description}}<meta name="description" content="{{page.description}}">{{/if}}
  {{!-- Start the font download with the stylesheet instead of after it, so text
        does not re-flow when Inter replaces the fallback font. --}}
  <link rel="preload" href="{{uiRootPath}}/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{uiRootPath}}/css/site.css?v=21">
</head>
<body class="docs-page">
  <a class="skip-link" href="#article-main">Skip to content</a>
  <header class="docs-header">
    <div class="docs-header-inner">
      <a class="docs-logo" href="{{{relativize site.homeUrl}}}"><span class="docs-logo-mark">AN</span><span>{{site.title}}</span></a>
      {{!-- A single AsciiDoc page owns the site-wide header links.
           Set site.keys.header_links_page to a fully qualified Antora page ID. --}}
      {{#if site.keys.headerLinksPage}}
        {{#with (resolvePage site.keys.headerLinksPage)}}
          <nav class="header-adoc-nav docs-toplinks" aria-label="Header links" data-header-source-url="{{{relativize url}}}">
            <div class="header-adoc-content">{{{contents}}}</div>
          </nav>
        {{else}}
          {{#if site.keys.contactUrl}}<nav class="docs-toplinks" aria-label="Contact"><a class="docs-contact-link" href="{{{relativize site.keys.contactUrl}}}">Contact</a></nav>{{/if}}
        {{/with}}
      {{else}}
        {{#if site.keys.contactUrl}}
        <nav class="docs-toplinks" aria-label="Contact"><a class="docs-contact-link" href="{{{relativize site.keys.contactUrl}}}">Contact</a></nav>
        {{/if}}
      {{/if}}
      {{!-- Decorative duplicate of the logo link: hidden from screen readers and skipped by Tab. --}}
      <a class="header-avatar" href="{{{relativize site.homeUrl}}}" aria-hidden="true" tabindex="-1"><img src="{{uiRootPath}}/img/profile-photo.png" alt="Ayush Nigam profile photo" width="36" height="36"></a>
<button type="button" class="mobile-nav-toggle" aria-label="Toggle documentation navigation" aria-expanded="false" aria-controls="docs-sidebar">☰ Menu</button>
      {{!-- Visual duplicate of the progress bar value, so hidden from screen readers. --}}
      <span class="read-progress-label" aria-hidden="true" hidden>Reading <span class="read-progress-value">0%</span></span>
    </div>
    {{!-- Article reading progress. The header persists across in-place navigation, so this
          is always present and js/reading-assistant.js shows it only when the current
          article has data-reading-progress (off with :page-no-reading-progress:). --}}
    <div class="read-progress" role="progressbar" aria-label="Article reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden><span class="read-progress-fill"></span></div>
  </header>
  <div class="docs-shell">
    <aside class="docs-sidebar" id="docs-sidebar" aria-label="Documentation sidebar">
      <div class="sidebar-inner">
      <div class="sidebar-top"><span class="sidebar-eyebrow">ENGINEERING LIBRARY</span></div>
      <input id="nav-filter" class="nav-filter" type="search" placeholder="Filter pages…" aria-label="Filter navigation" autocomplete="off">
      {{#if page.navigation}}<nav aria-label="Documentation pages">{{> nav-tree items=(navTree page.navigation page.url)}}</nav>{{else}}<p class="empty-nav">No navigation registered. List each module's nav.adoc under nav: in antora.yml.</p>{{/if}}
      </div>
    </aside>
    <main id="article-main" class="docs-article">
      {{!-- Antora marks site.start_page as page.home. Do not show Home / [same page] there. --}}
      {{#unless page.home}}
      {{#if page.breadcrumbs}}
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{{relativize site.homeUrl}}}">Home</a>{{#each page.breadcrumbs}}<span aria-hidden="true">/</span>{{#if url}}<a href="{{{relativize url}}}">{{{content}}}</a>{{else}}<span>{{{content}}}</span>{{/if}}{{/each}}</nav>
      {{/if}}
      {{/unless}}
      {{!-- :page-role: adds classes to the article, e.g. `coding-page` for the
            numbered problem-solving layout. Keeps presentation out of the AsciiDoc. --}}
      <article class="article-body{{#if page.attributes.role}} {{page.attributes.role}}{{/if}}"{{#if (lookup (readingInfo page) 'progress')}} data-reading-progress{{/if}}>
        {{#if page.title}}
        <header class="article-header{{#if page.attributes.centered}} article-header--centered{{/if}}">
          <h1>{{{page.title}}}</h1>
          {{#if page.attributes.author}}<p class="article-byline">{{page.attributes.author}}</p>{{/if}}
          {{!-- :page-subtitle: one-line summary shown under the heading. --}}
          {{#if page.attributes.subtitle}}<p class="article-subtitle">{{{page.attributes.subtitle}}}</p>{{/if}}
          {{!-- :page-difficulty: and :page-tags: render as the chip row. --}}
          {{#with (chipList page.attributes.difficulty page.attributes.tags)}}
          <ul class="article-chips">
            {{#each this}}<li class="chip {{cls}}">{{label}}</li>{{/each}}
          </ul>
          {{/with}}
          {{!-- Reading time, last-updated date and the assistant toggle (helpers/readingInfo.js). --}}
          {{#with (readingInfo page)}}
          {{#if meta}}
          <div class="article-meta">
            {{#if showTime}}
            <span class="article-meta-item" title="Estimated at {{wpm}} words per minute">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              ~{{minutes}} min read
            </span>
            {{/if}}
            {{#if revdate}}
            <span class="article-meta-item">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M16 3v4M8 3v4M4 10h16"/></svg>
              Updated {{#if revdateIso}}<time datetime="{{revdateIso}}">{{revdate}}</time>{{else}}{{revdate}}{{/if}}
            </span>
            {{/if}}
            {{#if assistant}}
            {{!-- Shown by JS. Opens the assistant drawer on narrow screens, or re-opens a closed panel. --}}
            <button type="button" class="ra-open" aria-controls="reading-assistant" aria-expanded="false" hidden>
              {{#if listen}}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
              Listen
              {{else}}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
              Sections
              {{/if}}
            </button>
            {{/if}}
          </div>
          {{/if}}
          {{/with}}
        </header>
        {{/if}}
        {{{page.contents}}}
      </article>
      <div class="article-pagination">
        {{#if page.previous}}<a class="prev" href="{{{relativize page.previous.url}}}"><span>← Previous</span><strong>{{{page.previous.content}}}</strong></a>{{/if}}
        {{#if page.next}}<a class="next" href="{{{relativize page.next.url}}}"><span>Next →</span><strong>{{{page.next.content}}}</strong></a>{{/if}}
      </div>
    </main>
    {{!-- Reading Assistant by default; classic "On this page" panel on the start page
          or with :page-no-reading-assistant:. --}}
    {{#if (lookup (readingInfo page) 'assistant')}}
    {{> reading-assistant (readingInfo page)}}
    {{else}}
    <aside class="docs-toc" aria-label="On this page">
      <div class="toc-inner">
      <div class="toc-heading">ON THIS PAGE</div>
      {{#if page.attributes.toc}}<div class="toc-note">Use section headings to jump within this article.</div>{{/if}}
      <nav id="js-local-toc"></nav>
      </div>
    </aside>
    {{/if}}
  </div>
  <footer class="docs-footer">© 2026 Ayush Nigam · <a href="{{{relativize site.homeUrl}}}">Home</a></footer>
  {{!-- Order matters: both are deferred, and site.js calls ReadingAssistant.refresh(). --}}
  <script src="{{uiRootPath}}/js/reading-assistant.js?v=2" defer></script>
  <script src="{{uiRootPath}}/js/site.js?v=15" defer></script>
</body>
</html>
